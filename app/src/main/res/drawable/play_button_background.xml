<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Brighter + a visible border when focused (the only interactive control on this screen,
         reached by the initial D-pad focus) so it's obvious it's already selected without having
         to press a direction key first. -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#8b5cf6" />
            <stroke android:width="3dp" android:color="#eeeeee" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#6d28d9" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
